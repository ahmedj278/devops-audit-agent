# Copy to .env and fill in. Never commit the real .env file.

# Which LLM provider to use: anthropic (default), openai or gemini
# Free option: gemini (get a free key at https://aistudio.google.com/apikey)
LLM_PROVIDER=gemini

# Provide the key for the provider you selected
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: override the model (defaults: claude-sonnet-5-5 / gpt-4o / gemini-2.5-flash)
LLM_MODEL=

# Optional: OpenAI-compatible endpoint
OPENAI_BASE_URL=

# Optional: GitHub token, only used to raise the GitHub API rate limit for the
# repository precheck. Not needed for public repositories.
GITHUB_TOKEN=

# Optional limits
AGENT_MAX_STEPS=40
AGENT_TIMEOUT_SECONDS=900
LLM_REQUEST_TIMEOUT=120
